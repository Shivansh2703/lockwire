<?xml version="1.0"?>
<!-- Synthetic: one five-bar leg (two hip cranks closed by a pin) and an open tail beside it.
     Hip "a" and the tail carry effort limits far too small for their open-chain gravity torque. -->
<sdf version="1.7">
  <model name="fivebar">
    <link name="base"><inertial><mass>1</mass></inertial></link>
    <link name="crank_a"><pose>0.02 0 0 0 0 0</pose><inertial><pose>0.02 0 0 0 0 0</pose><mass>0.1</mass></inertial></link>
    <link name="crank_b"><pose>-0.02 0 0 0 0 0</pose><inertial><pose>-0.02 0 0 0 0 0</pose><mass>0.1</mass></inertial></link>
    <link name="short_link"><pose>0.06 0 0 0 0 0</pose><inertial><pose>0 0 -0.02 0 0 0</pose><mass>0.1</mass></inertial></link>
    <link name="shin"><pose>-0.06 0 0 0 0 0</pose><inertial><pose>0.03 0 -0.05 0 0 0</pose><mass>0.1</mass></inertial></link>
    <link name="tail"><pose>-0.1 0 0 0 0 0</pose><inertial><pose>-0.05 0 0 0 0 0</pose><mass>0.1</mass></inertial></link>
    <joint name="a" type="revolute">
      <parent>base</parent><child>crank_a</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.6</lower><upper>0.6</upper><effort>0.0001</effort><velocity>8</velocity></limit></axis>
    </joint>
    <joint name="b" type="revolute">
      <parent>base</parent><child>crank_b</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.6</lower><upper>0.6</upper><effort>3</effort><velocity>8</velocity></limit></axis>
    </joint>
    <joint name="link" type="revolute">
      <parent>crank_a</parent><child>short_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2</lower><upper>2</upper><velocity>20</velocity></limit></axis>
    </joint>
    <joint name="knee" type="revolute">
      <parent>crank_b</parent><child>shin</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2</lower><upper>2</upper><velocity>20</velocity></limit></axis>
    </joint>
    <joint name="closure" type="revolute">
      <parent>short_link</parent><child>shin</child>
      <pose>0.12 0 -0.04 0 0 0</pose>
      <axis><xyz>0 1 0</xyz><limit><lower>-2</lower><upper>2</upper><velocity>20</velocity></limit></axis>
    </joint>
    <joint name="tail" type="revolute">
      <parent>base</parent><child>tail</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.6</lower><upper>0.6</upper><effort>0.0001</effort><velocity>8</velocity></limit></axis>
    </joint>
  </model>
</sdf>

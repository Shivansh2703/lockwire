<?xml version="1.0"?>
<!-- Synthetic, shaped like a public hobby arm seen 2026-11-07: STS3215 servos (stall 19.5 kg*cm
     = 1.91 N*m at 7.4 V) on joints whose URDF effort limit says 10 N*m. -->
<robot name="servo_arm">
  <link name="base"><inertial><mass value="0.5"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial></link>
  <link name="upper"><inertial><mass value="0.1"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1.5e-4"/></inertial></link>
  <link name="hand"><inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1.5e-5"/></inertial></link>
  <joint name="shoulder" type="revolute">
    <parent link="base"/><child link="upper"/><axis xyz="0 1 0"/>
    <limit effort="10" velocity="10" lower="-1.9" upper="1.9"/>
  </joint>
  <joint name="wrist" type="revolute">
    <parent link="upper"/><child link="hand"/><origin xyz="0 0 0.1"/><axis xyz="0 1 0"/>
    <limit effort="1" velocity="10" lower="-1.6" upper="1.6"/>
  </joint>
</robot>

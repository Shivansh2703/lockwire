<?xml version="1.0"?>
<!-- check-sim fixture, written by hand: the same three SO-101 links as SDF, every value
     copied from so101.urdf, so it agrees with lockwire.yaml. -->
<sdf version="1.9">
  <model name="so101">
    <link name="base_link">
      <inertial>
        <pose>0.0137179 -5.19711e-05 0.0334843 0 0 0</pose>
        <mass>0.147</mass>
        <inertia><ixx>0.000114686</ixx><ixy>-4.59787e-07</ixy><ixz>4.97151e-06</ixz>
          <iyy>0.000136117</iyy><iyz>9.75275e-08</iyz><izz>0.000130364</izz></inertia>
      </inertial>
    </link>
    <link name="shoulder_link">
      <pose>0.0388353 0 0.0624 0 0 0</pose>
      <inertial>
        <pose>-0.0307604 -1.66727e-05 -0.0252713 0 0 0</pose>
        <mass>0.100006</mass>
        <inertia><ixx>8.3759e-05</ixx><ixy>7.55525e-08</ixy><ixz>-1.16342e-06</ixz>
          <iyy>8.10403e-05</iyy><iyz>1.54663e-07</iyz><izz>2.39783e-05</izz></inertia>
      </inertial>
    </link>
    <link name="upper_arm_link">
      <inertial>
        <pose>-0.0898471 -0.00838224 0.0184089 0 0 0</pose>
        <mass>0.103</mass>
        <inertia><ixx>4.08002e-05</ixx><ixy>-1.97819e-05</ixy><ixz>-4.03016e-08</ixz>
          <iyy>0.000147318</iyy><iyz>8.97326e-09</iyz><izz>0.000142487</izz></inertia>
      </inertial>
    </link>
    <joint name="shoulder_pan" type="revolute">
      <parent>base_link</parent><child>shoulder_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.91986</lower><upper>1.91986</upper>
        <effort>10</effort><velocity>10</velocity></limit></axis>
    </joint>
    <joint name="shoulder_lift" type="revolute">
      <parent>shoulder_link</parent><child>upper_arm_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.74533</lower><upper>1.74533</upper>
        <effort>10</effort><velocity>10</velocity></limit></axis>
    </joint>
  </model>
</sdf>

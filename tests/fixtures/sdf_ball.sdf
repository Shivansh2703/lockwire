<?xml version="1.0"?>
<!-- Synthetic: a rover whose rocker swings on SDF ball joints. -->
<sdf version="1.9">
  <model name="ball_rover">
    <link name="chassis"><inertial><mass>4</mass></inertial></link>
    <link name="rocker"><pose>0.1 0 0 0 0 0</pose><inertial><mass>0.5</mass></inertial></link>
    <joint name="rocker_ball" type="ball">
      <parent>chassis</parent>
      <child>rocker</child>
    </joint>
  </model>
</sdf>

<?xml version="1.0"?>
<!-- AUBO's published link inertia tensor (ixx 0.0305, iyy 0.4505, izz 0.0095): 0.4505 > 0.0305 + 0.0095,
     so no real body has it. Before check pack 1 it passed as GO. -->
<robot name="aubo_tensor">
  <link name="base_link">
    <inertial><mass value="2"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.014"/></inertial>
  </link>
  <link name="forearm_link">
    <inertial><mass value="5"/><inertia ixx="0.0305" ixy="0" ixz="0" iyy="0.4505" iyz="0" izz="0.0095"/></inertial>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="base_link"/><child link="forearm_link"/>
    <limit lower="-3" upper="3" effort="50" velocity="3"/>
  </joint>
</robot>

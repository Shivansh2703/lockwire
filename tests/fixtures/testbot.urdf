<?xml version="1.0"?>
<!-- Synthetic M0 fixture: small quad-ish robot. One zero-mass link (sensor_mount)
     is deliberate — it must be flagged by init and warned on by check. -->
<robot name="testbot">
  <link name="base_link">
    <inertial>
      <origin xyz="0.01 0.0 0.02" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.011" ixy="0.0001" ixz="0.0" iyy="0.012" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>
  <link name="leg_link">
    <inertial>
      <origin xyz="0.0 0.0 -0.05" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0009" ixy="0.0" ixz="0.0" iyy="0.0009" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>
  <link name="sensor_mount"/>
  <link name="imu_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="hip" type="revolute">
    <parent link="base_link"/>
    <child link="leg_link"/>
    <origin xyz="0.1 0.0 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="8" velocity="10"/>
  </joint>
  <joint name="mount_fix" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mount"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
  </joint>
  <joint name="imu_fix" type="fixed">
    <parent link="sensor_mount"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.01" rpy="0 0 0"/>
  </joint>
</robot>

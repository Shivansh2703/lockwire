<?xml version="1.0"?>
<!-- Synthetic: a symmetric five-bar leg. Hips at x = +/-0.02, cranks 0.05 long splayed 3-4-5 from
     vertical, lower links 0.13 long meeting at the apex (0, 0, -0.16). The only mass is 1 kg at the
     apex, so each hip's holding torque has a closed form (tests/test_statics.py). -->
<sdf version="1.7">
  <model name="fivebar_sym">
    <link name="base"/>
    <link name="crank_r"><pose>0.02 0 0 0 0 0</pose></link>
    <link name="crank_l"><pose>-0.02 0 0 0 0 0</pose></link>
    <link name="lower_r"><pose>0.05 0 -0.04 0 0 0</pose></link>
    <link name="lower_l"><pose>-0.05 0 -0.04 0 0 0</pose><inertial><pose>0.05 0 -0.12 0 0 0</pose><mass>1</mass></inertial></link>
    <joint name="hip_r" type="revolute">
      <parent>base</parent><child>crank_r</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.3</lower><upper>0.3</upper><effort>5</effort><velocity>8</velocity></limit></axis>
    </joint>
    <joint name="hip_l" type="revolute">
      <parent>base</parent><child>crank_l</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.3</lower><upper>0.3</upper><effort>5</effort><velocity>8</velocity></limit></axis>
    </joint>
    <joint name="elbow_r" type="revolute">
      <parent>crank_r</parent><child>lower_r</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2</lower><upper>2</upper><velocity>20</velocity></limit></axis>
    </joint>
    <joint name="elbow_l" type="revolute">
      <parent>crank_l</parent><child>lower_l</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2</lower><upper>2</upper><velocity>20</velocity></limit></axis>
    </joint>
    <joint name="closure" type="revolute">
      <parent>lower_r</parent><child>lower_l</child>
      <pose>0.05 0 -0.12 0 0 0</pose>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
  </model>
</sdf>

<robot name="h1">
  <link name="base"><inertial><mass value="30"/><inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="knee"><inertial><mass value="3"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <joint name="knee_joint" type="revolute"><parent link="base"/><child link="knee"/><axis xyz="0 1 0"/><limit lower="0" upper="2" effort="360" velocity="10"/></joint>
</robot>

<robot name="continuous_leg">
  <link name="base"><inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial></link>
  <link name="hip"><inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial></link>
  <link name="thigh"><inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial></link>
  <link name="calf"><inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial></link>
  <link name="wheel"><inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial></link>
  <link name="plate"><inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial></link>
  <link name="arm"><inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial></link>
  <joint name="hip_joint" type="revolute"><parent link="base"/><child link="hip"/><axis xyz="0 0 1"/><limit lower="-1" upper="1" effort="1" velocity="1"/></joint>
  <joint name="thigh_joint" type="continuous"><parent link="hip"/><child link="thigh"/><axis xyz="0 0 1"/></joint>
  <joint name="calf_joint" type="revolute"><parent link="thigh"/><child link="calf"/><axis xyz="0 0 1"/><limit lower="-1" upper="1" effort="1" velocity="1"/></joint>
  <joint name="wheel_joint" type="continuous"><parent link="calf"/><child link="wheel"/><axis xyz="0 0 1"/></joint>
  <joint name="turntable" type="continuous"><parent link="base"/><child link="plate"/><axis xyz="0 0 1"/></joint>
  <joint name="arm_joint" type="revolute"><parent link="plate"/><child link="arm"/><axis xyz="0 0 1"/><limit lower="-1" upper="1" effort="1" velocity="1"/></joint>
</robot>

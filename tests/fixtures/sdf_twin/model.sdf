<?xml version="1.0"?>
<!-- Synthetic, shaped like a public TurtleBot3-style twin seen 2026-11-07: XL430 wheel servos
     (stall 1.5 N*m at 12 V) on joints whose SDF effort limit says 20, plus a 40 g, 7 mm-radius
     standoff with a 1e-4 placeholder inertia (51x what its cylinder can hold). -->
<sdf version="1.6">
  <model name="twin">
    <link name="base">
      <inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.14 0.14 0.14</size></box></geometry></collision>
    </link>
    <link name="wheel">
      <pose>0 0.08 0.023 -1.57 0 0</pose>
      <inertial><mass>0.03</mass><inertia><ixx>2e-5</ixx><iyy>2e-5</iyy><izz>3e-5</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry></collision>
    </link>
    <link name="standoff">
      <pose>0.05 0 0.1 0 0 0</pose>
      <inertial><mass>0.04</mass><inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.007</radius><length>0.16</length></cylinder></geometry></collision>
    </link>
    <joint name="wheel_joint" type="revolute">
      <parent>base</parent><child>wheel</child>
      <axis><xyz>0 0 1</xyz><limit><effort>20</effort></limit></axis>
    </joint>
    <link name="caster"><inertial><mass>0.01</mass><inertia><ixx>1e-7</ixx><iyy>1e-7</iyy><izz>1e-7</izz></inertia></inertial></link>
    <joint name="caster_joint" type="revolute"><parent>base</parent><child>caster</child><axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="standoff_joint" type="fixed"><parent>base</parent><child>standoff</child></joint>
  </model>
</sdf>

{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lockwirerobotics/lockwire",
  "title": "Lockwire",
  "description": "Checks that a robot's declared parts (power, weight, bus, torque) add up.",
  "repository": {
    "url": "https://github.com/Shivansh2703/lockwire",
    "source": "github"
  },
  "version": "0.5.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "lockwire",
      "version": "0.5.1",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        { "type": "named", "name": "--with", "value": "mcp>=2.2.0,<3" }
      ],
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ],
      "transport": { "type": "stdio" }
    }
  ]
}

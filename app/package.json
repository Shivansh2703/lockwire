{
  "name": "lockwire-app",
  "version": "0.2.5",
  "private": true,
  "main": "./out/main/index.js",
  "allowScripts": { "node-pty@1.1.0": true },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && node scripts/chmod-pty-helper.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "check:free": "node scripts/check-free.mjs",
    "contrast": "node scripts/contrast.mjs",
    "package": "node scripts/package.mjs"
  },
  "build": {
    "appId": "com.shivansh.lockwire",
    "productName": "Lockwire",
    "files": ["out/**/*"],
    "asarUnpack": ["node_modules/node-pty/**"],
    "npmRebuild": false,
    "icon": "assets/icon.png",
    "extraResources": [
      {
        "from": "build/sidecar-staging/sidecar-${platform}-${arch}",
        "to": "sidecar-${platform}-${arch}"
      }
    ],
    "mac": {
      "target": [{ "target": "dir", "arch": ["arm64"] }],
      "icon": "assets/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false
    },
    "linux": {
      "target": [{ "target": "dir", "arch": ["x64"] }, { "target": "AppImage", "arch": ["x64"] }]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "grantFileProtocolExtraPrivileges": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "resetAdHocDarwinSignature": true
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
